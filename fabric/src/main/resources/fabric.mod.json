{
  "schemaVersion": 1,
  "id": "areaminer",
  "version": "${version}+${minecraft_version}",
  "name": "AreaMiner",
  "description": "Area mining. Works in singleplayer, on Fabric servers, and as the settings client for the AreaMiner Paper plugin.",
  "authors": [
    "Yuhrp"
  ],
  "contact": {
    "sources": "https://github.com/LivingDeadDolls/AreaMiner"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "areaminer.server.AreaMinerMod"
    ],
    "client": [
      "areaminer.client.AreaMinerClient"
    ],
    "modmenu": [
      "areaminer.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "areaminer.mixins.json",
    {
      "config": "areaminer-client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
